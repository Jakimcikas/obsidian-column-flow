{
	"name": "column-flow",
	"version": "0.1.6",
	"description": "Editable side-by-side columns in Obsidian Live Preview",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node parse.test.ts",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts"
	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@codemirror/state": "^6.4.0",
		"@codemirror/view": "^6.26.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.0.0",
		"@wdio/cli": "^10.1.0",
		"@wdio/globals": "^10.1.0",
		"@wdio/local-runner": "^10.1.0",
		"@wdio/mocha-framework": "^10.1.0",
		"esbuild": "0.20.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"mocha": "^12.0.3",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5",
		"typescript-eslint": "^8.72.1",
		"wdio-obsidian-reporter": "^3.5.0",
		"wdio-obsidian-service": "^3.5.0",
		"webdriverio": "^10.1.0"
	}
}
