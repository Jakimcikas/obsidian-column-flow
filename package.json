	"devDependencies": {
		"@codemirror/state": "^6.4.0",
		"@codemirror/view": "^6.26.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@types/node": "^20.0.0",
		"esbuild": "0.20.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5",
		"typescript-eslint": "^8.72.1"
	}
}
