	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@codemirror/state": "^6.4.0",
		"@codemirror/view": "^6.26.0",
		"@types/node": "^20.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.20.2",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
