{
	"name": "column-flow",
	"version": "0.1.2",
	"description": "Editable side-by-side columns in Obsidian Live Preview",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
